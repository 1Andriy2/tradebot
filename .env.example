# Copy to .env and fill in. NEVER commit .env.
# All accounts must belong to andrijkostelnij72@gmail.com.
# Do NOT put ANTHROPIC_* / CLAUDE_* variables here: scripts/with-env.sh refuses them
# so that the Claude Code login of this machine is never changed.

# --- GitHub (fine-grained PAT, only this repository) ---
# https://github.com/settings/personal-access-tokens/new
GH_TOKEN=

# --- Supabase ---
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref = the id in https://supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=
# Project Settings -> API (used by the bot; service role key stays server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel ---
# https://vercel.com/account/settings/tokens
VERCEL_TOKEN=

# --- Demo exchange (venue chosen after research; demo/testnet keys only) ---
EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=
